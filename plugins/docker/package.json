{
  "name": "@devix/docker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Docker integration for Devix with graceful degradation when the daemon is unavailable.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@devix/shell": "workspace:*"
  },
  "devDependencies": {
    "eslint": "9.39.1"
  }
}
