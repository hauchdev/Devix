{
  "name": "@devix/deps",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Dependency operations for Devix: detect the package manager and delegate to it.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@devix/filesystem": "^0.0.1",
    "@devix/project-detector": "^0.0.1",
    "@devix/shell": "^0.0.1"
  },
  "devDependencies": {
    "eslint": "9.39.1"
  },
  "license": "MIT",
  "author": "hauchdev <hauch8bingo@proton.me>",
  "homepage": "https://github.com/hauchdev/Devix#readme",
  "bugs": "https://github.com/hauchdev/Devix/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hauchdev/Devix.git",
    "directory": "packages/deps"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
