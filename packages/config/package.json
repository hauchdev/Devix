    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "eslint": "10.11.0"
  },
  "dependencies": {
    "@devix-cli/filesystem": "^0.1.0"
