{
  "name": "@devix-cli/output",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@devix-cli/core": "workspace:*"
  },
  "devDependencies": {
    "eslint": "9.39.1"
  },
  "description": "Canonical output and exit codes for Devix commands.",
  "license": "MIT",
  "author": "hauchdev <hauch8bingo@proton.me>",
  "homepage": "https://github.com/hauchdev/Devix#readme",
  "bugs": "https://github.com/hauchdev/Devix/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hauchdev/Devix.git",
    "directory": "packages/output"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
