{
  "name": "devix-cli",
  "version": "0.2.0",
  "type": "module",
  "description": "The Devix CLI: understands your environment (Node, pnpm, Git, Docker) and your project, so you don't have to memorize it.",
  "license": "MIT",
  "author": "hauchdev <hauch8bingo@proton.me>",
  "homepage": "https://github.com/hauchdev/Devix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hauchdev/Devix.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/hauchdev/Devix/issues",
  "keywords": [
    "cli",
    "developer-tools",
    "devops",
    "project-detection",
    "environment",
    "git",
    "docker"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "devix": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@devix-cli/core": "^0.1.1",
    "@devix-cli/deps": "^0.2.0",
    "@devix-cli/docker": "^0.1.1",
    "@devix-cli/doctor": "^0.2.0",
    "@devix-cli/git": "^0.1.0",
    "@devix-cli/project-detector": "^0.2.0",
    "@oclif/core": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "9.39.1"
  },
  "oclif": {
    "bin": "devix",
    "dirname": "devix",
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands"
    },
    "topicSeparator": " "
  }
}
